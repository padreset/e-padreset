<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud backup rules (Android 12+). The pre-write EEPROM backups in
    "waste_backup_history" stay on the device: uploading them would copy
    printer internals to the user's Google account and restore them onto a
    reinstall where the model guard is the only thing stopping a cross-printer
    write. Everything else keeps the default backup behavior.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="waste_backup_history" />
    </cloud-backup>
</data-extraction-rules>
