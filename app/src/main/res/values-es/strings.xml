<?xml version="1.0" encoding="utf-8"?>
<!--
  Traducción al español de E-Pad Reset.

  Debe contener exactamente las mismas claves que values/strings.xml. Las que
  falten caen al inglés automáticamente, así que una traducción parcial no rompe
  nada, pero deja la interfaz mezclada.

  No se incluye about_repo_label: es el identificador del repositorio, no texto
  que deba traducirse.
-->
<resources>
    <string name="app_name">E-Pad Reset</string>

    <!-- Descripciones accesibles de los controles que solo llevan icono. -->
