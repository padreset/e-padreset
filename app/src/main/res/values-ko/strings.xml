    <!-- Warning shown above the waste counters. -->
    <string name="pad_warning_title">재설정해도 패드가 청소되지는 않습니다</string>
    <string name="pad_warning_body">카운터는 전자적 수치이고, 패드는 물리적인 부품입니다. 재설정하기 전에 폐잉크 패드를 세척하거나 교체 또는 폐잉크를 외부로 배출하도록 조치하지 않으면 결국 프린터 내부로 잉크가 샐 수 있습니다.</string>

    <!-- Shown in place of the counters when the connected printer keeps its
         waste ink counter somewhere the app cannot write to. Deliberately does
         not claim to know which of the two causes applies: the catalog can tell
         that a model has no counter, but not whether that is a maintenance box
         or a gap in the database. The dialog explains both. -->
    <string name="waste_unsupported_title">이 모델에는 재설정할 카운터가 없습니다</string>
    <string name="waste_unsupported_body">이 프린터에는 앱에서 재설정할 수 있는 폐잉크 카운터가 없습니다. 고장이 난 것이 아니며, 앱이나 프린터 모두 문제가 없습니다.</string>
    <string name="action_more_info">자세한 정보</string>
    <!-- A printer that answered, but is not in the catalog. Not the same as
         waste_unsupported: that one means the catalog knows there is nothing
         to reset. This one means we do not have a verified profile, so we
         must not claim the printer has no counter. -->
    <string name="partial_session_title">검증된 프로필 없이 연결됨</string>
    <string name="partial_session_body">상태 및 잉크 잔량은 확인할 수 있습니다. 앱에 검증된 프로필이 등록될 때까지는 폐잉크 카운터를 읽거나 재설정할 수 없습니다. 모델 지원을 요청할 수 있으며, 지원 요청이 완료되지 않아도 현재 수치는 바로 확인할 수 있습니다.</string>
    <string name="partial_cleaning_note">헤드 청소는 잉크를 소모하며 폐잉크 카운터 수치를 증가시킵니다. 이 프린터에는 검증된 프로필이 없으므로 이 앱으로 카운터를 재설정할 수 없습니다.</string>
    <string name="error_power_clean_unverified">검증된 프로필 없이는 강력 청소를 사용할 수 없습니다. 강력 청소는 더 많은 잉크를 소모하며, 이 앱에서 폐잉크 카운터를 되돌릴 수 없습니다.</string>

    <!-- Shown next to a counter whose ceiling the model does not publish, which
         is every model sourced from reinkpy. Without a ceiling there is no
         percentage, and the raw value is what the printer actually reports. -->
    <string name="waste_scale_unknown">백분율 없음: 이 모델의 카운터 한계값이 공개되지 않았습니다. 위의 값은 측정된 원시 수치입니다.</string>
    <!-- Reset dialog body for those same models. There is no percentage field
         and no per-counter choice, because the reset covers every address the
         model publishes. -->
    <string name="dialog_reset_model_values">이 모델의 카운터 한계값이 공개되지 않아 목표 백분율이 없습니다. 재설정 시 이 모델에 등록된 모든 주소에 대해 공개된 기본값을 기록합니다.</string>

    <!-- The EEPROM backup taken before any write. Shown after the write, whether
         it succeeded or was refused partway through. -->
    <string name="section_waste_backup">기록 전 백업</string>
    <string name="waste_backup_note">기록 전에 이 주소들에 저장되어 있던 값입니다. 문제가 발생할 경우 복원할 수 있도록 복사본을 보관하세요.</string>
    <string name="action_copy_backup">백업 복사</string>
    <string name="backup_copied">백업 복사됨</string>
    <!-- Write-path failures. The first pair means nothing was written at all;
         the second means the printer refused partway through. -->
    <string name="error_backup_failed">현재 값을 읽을 수 없어 아무것도 기록되지 않았습니다. 앱은 값을 기록하기 전에 먼저 백업합니다.</string>
    <string name="error_backup_failed_at">%1$s 위치의 현재 값을 읽을 수 없어 아무것도 기록되지 않았습니다. 앱은 값을 기록하기 전에 먼저 백업합니다.</string>
    <string name="error_write_rejected">프린터가 기록을 거부했습니다. 더 이상 기록되지 않았습니다.</string>
    <string name="error_write_rejected_at">프린터가 %1$s 위치에서 기록을 거부했습니다. %2$d개 주소가 이미 기록되었으며, 더 이상 기록되지 않았습니다. 백업은 아래에 있습니다.</string>

    <!-- Restoring a saved backup.
         The backup is saved by the app before every write, so the case this
         covers is the one where the mistake is noticed later - usually with the
         app already closed. That is why it is automatic and why it is kept on
         disk, and the wording says so rather than presenting a button.
         Restoring raises the counters, which is the opposite of a reset, so the
         dialog says that plainly instead of leaving it to be discovered. -->
    <string name="section_restore_backup">백업 복원</string>
    <string name="restore_note">매번 기록하기 전에 백업이 자동으로 저장됩니다. 이전 값으로 되돌리려면 목록에서 선택하거나 보관해 둔 백업을 붙여넣으세요.</string>
    <string name="restore_no_history">아직 저장된 백업이 없습니다. 매번 기록하기 전에 백업이 자동으로 하나씩 저장됩니다.</string>
    <string name="action_restore_selected">선택한 백업 복원</string>
    <string name="action_restore_paste">붙여넣은 텍스트에서 복원</string>
    <string name="restore_record_label">%1$s — %2$s</string>
    <string name="restore_unknown_model">알 수 없는 모델</string>
    <!-- Which write found the state a saved record holds, and what it reads.
         Two records can look identical by model and time, so without these the
         list gives no way to tell which one undoes the mistake. The "unknown"
         wording covers records saved before the origin was recorded at all. -->
    <string name="restore_origin_reset">재설정 전에 저장됨</string>
    <string name="restore_origin_restore">복원 전에 저장됨</string>
    <string name="restore_origin_unknown">기록 전에 저장됨</string>
    <string name="restore_record_detail">%1$s · %2$s</string>
    <string name="restore_record_reads">읽은 값: %1$s</string>
    <string name="dialog_restore_title">이 백업을 복원하시겠습니까?</string>
    <string name="dialog_restore_body">이전 기록 전에 저장된 값을 다시 기록합니다. 이는 카운터 수치를 증가시키므로 재설정과 정반대의 동작입니다. 이전 작업을 취소할 때만 사용하세요.</string>
    <string name="dialog_restore_model">백업 출처: %1$s</string>
    <string name="dialog_restore_no_model">이 백업에는 프린터 모델명이 명시되어 있지 않습니다. 이 프린터에서 가져온 백업인지 확인하세요.</string>
    <string name="dialog_restore_addresses">%1$d개 주소에 기록됩니다.</string>
    <string name="dialog_restore_counter_delta">%1$s: %2$s → %3$s</string>
    <string name="action_restore">복원</string>
    <string name="dialog_paste_backup_title">백업 붙여넣기</string>
    <string name="field_paste_backup">백업 텍스트</string>
    <string name="paste_backup_hint">이전에 복사한 백업을 헤더 줄 포함 또는 제외하여 붙여넣으세요.</string>
    <string name="paste_backup_invalid">백업 줄을 찾을 수 없습니다. 앱에서 제공한 텍스트 또는 최소한 \"0x001C = 0x3F\" 형식의 줄을 붙여넣으세요.</string>
    <string name="paste_backup_parsed">%1$d개 주소를 찾았습니다.</string>
    <!-- Blocked rather than warned: the addresses belong to the model, so
         writing one printer's record onto another would write to addresses that
         mean something else there. -->
    <string name="error_restore_model_mismatch">이 백업은 %1$s에서 생성되었지만 현재 연결된 프린터는 %2$s입니다. 다른 모델에 복원하면 잘못된 주소에 기록될 수 있으므로 차단되었습니다.</string>

    <!-- Shown when the model is on the curated maintenance-box list, so the
         cause is known rather than guessed. The dialog that follows is the
         tailored one below, not the two-cause one. -->
    <string name="waste_box_title">이 프린터는 유지보수 상자를 사용합니다</string>
    <string name="waste_box_body">폐잉크는 유지보수 상자로 들어가며, 상자 자체의 칩에 사용량이 기록됩니다. 프린터 본체에는 앱에서 재설정할 수 있는 카운터가 없으며, 상자가 가득 차면 상자를 교체해야 합니다.</string>
    <string name="waste_box_dialog_title">프린터가 유지보수 상자를 사용합니다</string>
    <string name="waste_box_dialog_body">헤드 청소 시 발생하는 폐잉크는 프린터 내부의 패드가 아닌 유지보수 상자에 모입니다. 유지보수 상자에는 얼마나 찼는지를 기록하는 자체 칩이 내장되어 있으며, 프린터 본체에는 별도의 카운터가 없으므로 재설정 유틸리티로 초기화할 수 있는 항목이 없습니다.\n\n유지보수 상자가 가득 차면 새 상자로 교체하거나 전용 리셋 도구로 칩을 재설정해야 합니다. 두 방법 모두 앱에서 USB를 통해 수행할 수 있는 작업이 아닙니다.\n\n프린터 본체에서도 이를 확인할 수 있습니다. 프린터의 상태 패널에 유지보수 상자가 표시되며, 교체가 필요할 때 경고가 나타납니다.\n\n이 프린터에서도 헤드 청소와 노즐 검사는 정상적으로 작동합니다. 유지보수 화면에서 이용할 수 있습니다.</string>

    <string name="waste_unsupported_dialog_title">폐잉크 카운터 저장 위치 안내</string>
    <string name="waste_unsupported_dialog_body">Epson은 폐잉크 카운터를 다음 두 곳 중 하나에 저장합니다.\n\n내부 패드: 폐잉크가 프린터 내부의 패드에 흡수되며, 잔량 수치는 프린터 자체 메모리에 저장됩니다. 이 경우가 바로 본 앱에서 재설정할 수 있는 방식입니다.\n\n유지보수 상자: 폐잉크가 분리 가능한 상자에 모이며, 상자 자체의 칩에 사용량이 기록됩니다. 프린터 메모리에는 카운터가 저장되지 않으므로 어떤 소프트웨어로도 초기화할 수 없습니다. 상자를 교체하거나 전용 리셋 도구로 칩을 재설정해야 합니다.\n\n어느 방식인지 확인하려면 프린터 자체의 상태 패널을 확인하세요. 유지보수 상자가 표시된다면 어떤 재설정 유틸리티로도 초기화할 수 없습니다.\n\n프린터가 내부 패드를 사용하는데도 이 메시지가 표시된다면, 단순히 앱 데이터베이스에 해당 모델이 누락된 것입니다. 이 문제는 해결할 수 있으므로 개발팀에 알려주시기 바랍니다.\n\n이 프린터에서도 헤드 청소와 노즐 검사는 정상적으로 작동합니다. 유지보수 화면에서 이용할 수 있습니다.</string>

