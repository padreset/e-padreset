    <!-- Messages raised by the ViewModel. -->
    <string name="error_printer_not_connected">プリンターが接続されていません</string>
    <!-- Shown in the red callout when a forced rescan comes up empty. The Wi-Fi
         clause lives here and not in the "No printer" hint on purpose: the hint
         is ambient, seen by everyone on every launch, and a reader who does not
         have the language should not meet a wall of text there. This one only
         appears after the user asked for a rescan, which is when the question
         "why can it not see mine?" is actually being asked.

         "Note:" is load-bearing, not decoration. Without it the two sentences
         sit side by side and read as a diagnosis — as if the app had worked out
         that the user was reaching for the printer over Wi-Fi, which may have
         nothing to do with why the scan came up empty. Marked as a note it is
         what it is: an aside about what this app does. -->
    <string name="error_no_printer_detected">USB OTG経由でエプソンプリンターが検出されませんでした。※本アプリはWi-Fi接続に対応していません。</string>
    <!-- Raised when a USB printer is attached but its vendor is not Epson. The
         generic line above reads as a fault to someone holding a printer, so
         this one names the real reason: the app is Epson-only. -->
    <string name="error_non_epson_printer_detected">USBプリンターが接続されましたが、エプソン製ではありません。本アプリはエプソン製インクジェットプリンター専用です。</string>
    <string name="error_connect_failed">プリンターとのメンテナンスセッションを開始できませんでした</string>

    <!-- Shown when the printer is unplugged while the app is open. A statement
         rather than a failure: nothing the user did went wrong. -->
    <string name="notice_printer_disconnected">プリンターが切断されました。再接続して「更新」をタップしてください。</string>

    <!-- Connection failures, resolved from PrinterService.ConnectFailure so the
         callout can name the actual cause instead of a generic failure. -->
    <string name="error_connect_permission_denied">USBアクセス権限が拒否されました。プリンターを再接続し、権限を許可してください。</string>
    <!-- Kept apart from error_connect_permission_denied: the check that failed
         cannot tell a refusal from a printer that is no longer there, and
         sending someone to look for a permission dialog that will never appear
         is worse than saying nothing. -->
    <string name="error_connect_device_detached">プリンターが取り外されました。再度接続してやり直してください。</string>
    <string name="error_connect_no_interfaces">このUSB機器には使用可能なインターフェースがありません。対応するエプソンプリンターではない可能性があります。</string>
    <string name="error_connect_unsupported_model">このエプソン機種はアプリのデータベースに未登録のため、セッションを開けません。追加調査をリクエストできます（対応には検証済みデータと実機検証が必要であり保証はされません）。</string>
    <string name="error_connect_unsupported_model_named">エプソン「%1$s」はデータベースに未登録のため、セッションを開けません。追加調査をリクエストできます（対応には検証済みデータと実機検証が必要であり保証はされません）。</string>
    <!-- The mirror image of the two lines above. The model is missing from the
         database as well, but the community database classifies it as using a
         maintenance box, so adding it would never enable a reset. Kept apart so
         the app does not promise an outcome the hardware cannot deliver. -->
    <string name="error_connect_unsupported_model_box">このエプソン機種はデータベースに未登録で、コミュニティカタログ上ではメンテナンスボックス方式に分類されています。クリーニングやノズルチェック対応はリクエストできますが、本アプリでボックスチップのカウンターをリセットすることはできません。</string>
    <string name="error_connect_unsupported_model_box_named">エプソン「%1$s」はデータベースに未登録で、コミュニティカタログ上ではメンテナンスボックス方式に分類されています。クリーニングやノズルチェック対応はリクエストできますが、本アプリでボックスチップのカウンターをリセットすることはできません。</string>
    <string name="error_connect_dot4_nak">プリンターがメンテナンスセッションを拒否しました。プリンターの電源を入れ直して再試行してください。</string>
    <string name="error_connect_dot4_no_reply">いずれのUSB経路からもプリンターの応答がありません。ケーブルやポートを変えるか、電源を入れ直して再試行してください。</string>
    <!-- "may be using it", not "is using it": claimInterface returns a bare
         boolean, so a device that vanished mid-connect is indistinguishable
         from one another app holds. The attachment re-check narrows it, and the
         wording no longer asserts what the check cannot prove. -->
    <string name="error_connect_interface_busy">プリンターのUSB接続を占有できませんでした。他の印刷アプリやサービスが使用中の可能性があります。終了して再試行してください。</string>
    <string name="error_reset_partial_shared">これらのカウンターは他のカウンターとメモリバイトを共有しているため、個別にはリセットできません。該当するすべてのカウンターを選択してください。</string>
    <!-- The refusals the service raises before it writes anything. Each one used
         to reach the user as "Operation failed"; they are kept apart because
         each names a different thing the user can do about it. -->
    <string name="error_reset_no_counter_selected">廃インクカウンターが選択されていないため、リセット対象がありません。</string>
    <string name="error_reset_no_values">この機種には選択されたカウンターのリセット値が公開されていません。</string>
    <string name="error_reset_percentage_unsupported">この選択では目標パーセントを設定できません（上限値が公開されており、4バイト以内で、他と共有されていない必要があります）。</string>
    <string name="error_restore_no_applicable_addresses">このバックアップには現在接続中のプリンターで有効なアドレスが含まれていません。</string>

    <!-- A local draft is reviewed before any external action. -->
    <string name="action_report_model">機種追加に協力する</string>
    <string name="action_copy_report">レポートをコピー</string>
    <string name="report_model_note">端末内で限定レポートを作成・確認した上で共有方法を選択できます。アプリが自動でインターネット接続することはありません。</string>
    <string name="dialog_model_support_title">機種対応のリクエスト</string>
    <string name="field_model_report">確認・編集用レポート</string>
    <string name="action_choose_report_channel">共有方法を選択</string>
    <string name="action_review_report">レポートを再確認</string>
    <string name="action_report_discord">Discordを開く</string>
    <string name="action_report_github">GitHub Issueを開く</string>
    <string name="action_share_report">レポートを共有</string>
    <string name="report_privacy_note">対応は保証されません。このレポートには機種名、USB ID、アプリとAndroidのバージョンのみが含まれ、通信ログ、製造番号、EEPROMバックアップは含まれません。追加した内容を確認してください。外部共有は各アプリのプライバシーポリシーに従って行われます。</string>
    <string name="report_discord_help">Discordアカウントが必要です。レポートをコピーし、コミュニティで機種リクエストの投稿先をお尋ねください（招待リンクを開いても自動投稿はされません）。</string>
    <string name="report_github_help">GitHubアカウントが必要です。レポートをコピーし、Issueテンプレートに貼り付けてください。リンクに診断情報は含まれません。</string>
    <string name="report_share_help">GitHubやDiscordをお持ちでない場合は、普段お使いのアプリ経由で開発者に転送できる方へ共有してください。共有シートを開いても管理者に届いたことを意味するものではありません。</string>
    <string name="report_external_unavailable">この操作を開けるアプリがありませんでした。レポートをコピーして手動で貼り付けてください。</string>
    <string name="report_copied">レポートをコピーしました</string>
    <string name="msg_counters_updated">廃インクカウンターを更新しました。必要に応じてプリンターを再起動してください。</string>
    <!-- Byte-level verification names addresses, not derived percentages. A
         mismatch does not mean nothing changed: other writes may have applied. -->
    <string name="error_counters_not_applied">%1$s で読み取ったバイトが送信したリセット値と一致しません。一部の値のみ変更された可能性があります。バックアップは以下、詳細は通信ログをご確認ください。</string>
    <string name="error_restore_not_applied">%1$s で読み取ったバイトが送信した復元値と一致しません。一部の値のみ変更された可能性があります。バックアップは以下、詳細は通信ログをご確認ください。</string>
    <string name="error_write_failed">%1$s への書き込みが完了しなかったか、応答を読み取れませんでした。手前の %2$d 件のアドレスは書き込まれています。以降の書き込みは中断されました。バックアップは以下にあります。</string>
    <string name="error_read_back_failed">書き込みは完了しましたが、検証用の読み戻しができませんでした。結果は未検証です。バックアップは以下にあります。</string>
    <string name="error_read_back_failed_at">書き込みは完了しましたが、%1$s のバイトを読み戻せませんでした。結果は未検証です。バックアップは以下にあります。</string>
    <string name="msg_backup_restored">保存されていた値を書き戻しました。必要に応じてプリンターを再起動してください。</string>
    <string name="msg_cleaning_sent_named">ヘッドクリーニングコマンド「%1$s」を送信しました。プリンターが動作を開始するまで待ち、手動で状態を更新してください。</string>
    <string name="msg_cleaning_sent">ヘッドクリーニングジョブを送信しました。プリンターが動作を開始するまで待ち、手動で状態を更新してください。</string>
    <string name="msg_nozzle_check_sent">ノズルチェック印刷ジョブを送信しました。印刷が完了するまでお待ちください。</string>

    <!-- Readouts. The em dash stands for "no reading yet". -->
    <string name="percent_value">%1$d%%</string>
    <string name="waste_counter_default_name">廃インクカウンター %1$d</string>

    <!-- Printer state, resolved from the code the printer reports. EpsonProtocol
         still produces English text for the diagnostic log; the UI maps the code
         to these labels, so the status line is translatable. -->
    <string name="printer_state_self_printing">自己印刷中</string>
    <string name="printer_state_busy">ビジー</string>
    <string name="printer_state_waiting">待機中</string>
    <string name="printer_state_idle">待機中（アイドル）</string>
    <string name="printer_state_pause">一時停止中</string>
    <string name="printer_state_cleaning">クリーニング中</string>
    <string name="printer_state_error">エラー</string>

    <!-- Printer error, resolved from the code the printer reports. -->
    <string name="printer_error_interface">インターフェースエラー</string>
    <string name="printer_error_paper_jam">紙詰まり</string>
    <string name="printer_error_ink_out">インクエンド</string>
    <string name="printer_error_paper_feed">用紙切れまたは給紙エラー</string>
    <string name="printer_error_service_required">廃インク吸収パッドの限界または修理が必要</string>
    <string name="printer_error_cover_open">カバーが開いています</string>

    <!--
      Still not translatable, and deliberately left in the protocol layer:

        Ink colour names (InkLevel.color), e.g. "Black", "Light Cyan".

      They are never shown to the user. The gauges display short labels derived
      from them, and the same strings double as matching keys for the sort order
      and for the gauge colour, so translating them would change behaviour
      rather than just wording.
    -->
    <string name="temporary_backup_title">バックアップが保存されていません</string>
    <string name="temporary_backup_warning">完全なバックアップはメモリ上のみに存在します。アプリ終了やプロセスキルにより失われます。まだ1バイトも書き込まれていません。リスクを了承の上で続行してください（先にバックアップテキストをコピーしてください）。</string>
    <string name="action_continue_temporary">一時バックアップのまま続行</string>
    <string name="error_restore_incomplete_counter">バックアップにカウンターの一部しか含まれていません。完全なグループを復元してください。書き込みは行われませんでした。</string>
    <string name="error_restore_unit_mismatch">このバックアップは別のプリンター個体のものです。書き込みは行われませんでした。</string>
    <string name="dialog_restore_legacy_identity">このバックアップには元のプリンター個体識別情報がありません。このプリンターのものであることを確認の上で復元してください。</string>
    <string name="exit_busy_warning">処理が実行中です。今終了すると書き込みが中断され、カウンターの値が不整合になる恐れがあります。可能な限り完了までお待ちください。</string>
</resources>
