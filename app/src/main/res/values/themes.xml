<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.EPadReset" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Fondo de ventana y de la pantalla de arranque. Sin declararlos, el
             tema base de Material 3 pinta el splash con #FEF7FF. -->
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/splash_background</item>
        <item name="android:statusBarColor" tools:targetApi="l">#F6F8FB</item>
        <item name="android:navigationBarColor" tools:targetApi="l">#F6F8FB</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
