<resources>
    <!-- El icono adaptativo usa el logo en el primer plano sobre un fondo blanco
         plano. El primer plano es un vector de un solo color, asi que no hace
         falta ninguna variante raster para API 26+. -->
    <color name="ic_launcher_background">#FFFFFF</color>

    <!-- Fondo de la pantalla de arranque. Sin declararlo, Material 3 usa su
         superficie base por defecto (#FEF7FF), que tira a lavanda y se percibe
         como rosada. -->
    <color name="splash_background">#FFFFFF</color>

    <!-- Tinta del logo en la pantalla de arranque. Es el mismo azul que el
         acento claro de la app (PadLight.accent), y en tema oscuro cambia a
         PadDark.accent desde values-night. El icono de lanzador NO lo usa: ese
         es una marca fija y no debe seguir al tema. -->
    <color name="splash_logo">#0B47C1</color>
</resources>
