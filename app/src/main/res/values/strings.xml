<?xml version="1.0" encoding="utf-8"?>
<!--
  User-facing copy for E-Pad Reset.

  Translating the app means adding a values-<locale>/strings.xml with the same
  keys. Anything not listed here is deliberately not translated:

    - Protocol log lines and exception messages. They are technical diagnostics,
      and users search for the exact English wording when asking for help. When a
      failure is reachable by the user, the ViewModel does not surface the raw
      exception text in the error callout; it shows a message from this file
      instead, and the English detail stays in the log.
    - Ink colour names, which are never displayed: the gauges show short labels
      derived from them, and they double as matching keys for sorting and for the
      gauge colour, so translating them would change behaviour.
    - XML tag names and protocol constants.
-->
<resources>
    <string name="app_name">E-Pad Reset</string>

    <!-- Accessibility descriptions for the icon-only controls. The icons carry
         the meaning visually, but screen readers need something to announce. -->
    <string name="action_about">About</string>
    <string name="action_refresh_status">Refresh status</string>
    <string name="action_connect_printer">Connect printer</string>
    <string name="action_copy_log">Copy protocol log</string>
    <string name="action_open_maintenance">Open maintenance</string>
    <string name="action_back">Back</string>

    <!-- Section headings. -->
    <string name="section_printer">Printer</string>
    <string name="section_ink_levels">Ink levels</string>
    <string name="section_waste_levels">Waste levels</string>
    <string name="section_maintenance">Maintenance</string>
    <string name="section_protocol_log">Protocol log</string>

    <!-- Printer status block. -->
    <string name="status_working">Working</string>
    <string name="status_scanning">Scanning for an Epson printer over USB OTG</string>
    <string name="status_no_printer">No printer</string>
    <string name="status_no_printer_hint">Connect an Epson printer over USB OTG, then tap the refresh button</string>
    <string name="status_printer_error">The printer reported an error</string>
    <string name="status_ready">Ready</string>
    <string name="status_connected">Connected over USB OTG</string>
    <string name="status_busy_indicator">Working…</string>
    <!-- Shown while a connection is spending seconds on a route the printer did
         not answer on, before the next one is tried. Says what is happening and
         how long, because the wait is otherwise unexplained. -->
    <string name="connect_slow_note">No answer on the first connection route, so another is being tried. This can take a few seconds, and should be quicker next time.</string>
    <!-- The same situation as connect_slow_note, for the floating pill. Three
         words, because the pill is small and the card below it carries the
         explanation. Says what the app is doing, so the wait reads as progress
         rather than a stall; the duration is the card's job. -->
    <string name="connect_slow_brief">Trying another route…</string>

    <!-- Detail rows inside the printer card. -->
    <string name="label_model">Model</string>
    <string name="label_serial">Serial</string>
    <string name="label_highest_pad">Highest pad</string>

    <!-- Protocol log panel. -->
    <string name="log_empty">No log entries yet.</string>
    <string name="log_copied">Protocol log copied</string>

    <!-- Warning shown above the waste counters. -->
    <string name="pad_warning_title">Resetting does not clean the pad</string>
    <string name="pad_warning_body">The counter is electronic; the pad is physical. Wash, replace or redirect the waste ink before resetting, or ink will eventually leak inside the printer.</string>

    <!-- Shown in place of the counters when the connected printer keeps its
         waste ink counter somewhere the app cannot write to. Deliberately does
         not claim to know which of the two causes applies: the catalog can tell
         that a model has no counter, but not whether that is a maintenance box
         or a gap in the database. The dialog explains both. -->
    <string name="waste_unsupported_title">No counter to reset on this model</string>
    <string name="waste_unsupported_body">This printer does not keep a waste ink counter the app can reset. Nothing is broken: neither the app nor the printer is at fault.</string>
    <string name="action_more_info">More Information</string>

    <!-- Shown next to a counter whose ceiling the model does not publish, which
         is every model sourced from reinkpy. Without a ceiling there is no
         percentage, and the raw value is what the printer actually reports. -->
    <string name="waste_scale_unknown">No percentage: this model\'s counter limit is not published. The value above is the raw reading.</string>
    <!-- Reset dialog body for those same models. There is no percentage field
         and no per-counter choice, because the reset covers every address the
         model publishes. -->
    <string name="dialog_reset_model_values">This model\'s counter limit is not published, so there is no target percentage. The reset writes the values published for this model, across every address it lists.</string>

    <!-- The EEPROM backup taken before any write. Shown after the write, whether
         it succeeded or was refused partway through. -->
    <string name="section_waste_backup">Backup before write</string>
    <string name="waste_backup_note">The values these addresses held before the write. Keep a copy so you can put them back if something goes wrong.</string>
    <string name="action_copy_backup">Copy backup</string>
    <string name="backup_copied">Backup copied</string>
    <!-- Write-path failures. The first pair means nothing was written at all;
         the second means the printer refused partway through. -->
    <string name="error_backup_failed">The current values could not be read, so nothing was written. The app backs up before it writes.</string>
    <string name="error_backup_failed_at">The current value at %1$s could not be read, so nothing was written. The app backs up before it writes.</string>
    <string name="error_write_rejected">The printer refused the write. Nothing further was written.</string>
    <string name="error_write_rejected_at">The printer refused the write at %1$s. %2$d address(es) had already been written; nothing further was written. The backup is below.</string>

    <!-- Shown when the model is on the curated maintenance-box list, so the
         cause is known rather than guessed. The dialog that follows is the
         tailored one below, not the two-cause one. -->
    <string name="waste_box_title">This printer uses a maintenance box</string>
    <string name="waste_box_body">The waste ink goes into a box, and the box records the level on its own chip. There is no counter in the printer for the app to reset — when the box fills, it is replaced.</string>
    <string name="waste_box_dialog_title">Your printer uses a maintenance box</string>
    <string name="waste_box_dialog_body">The waste ink from head cleaning collects in a maintenance box rather than in pads inside the printer. The box carries its own chip that records how full it is, and the printer keeps no counter of its own — so there is nothing here for any reset utility to clear.\n\nWhen the box is full it is replaced, or its chip is reset with a dedicated tool. Neither is something an app can do over USB.\n\nYou can confirm this on the printer itself: its status panel names the maintenance box, and warns you when the box needs changing.\n\nHead cleaning and the nozzle check still work on this printer. They are on the Maintenance page.</string>

    <string name="waste_unsupported_dialog_title">Where the waste ink count lives</string>
    <string name="waste_unsupported_dialog_body">Epson stores the waste ink count in one of two places.\n\nInternal pad: the ink is absorbed by pads inside the printer and the fill level is kept in the printer\'s own memory. This is the case this app can reset.\n\nMaintenance box: the ink collects in a box you can remove, and the box carries its own chip that records the fill level. The printer\'s memory holds no counter, so no software can clear it. The box is replaced, or its chip is reset with a dedicated tool.\n\nTo find out which one you have, check the printer\'s own status panel. If it reports a maintenance box, no reset utility can help.\n\nIf your printer uses an internal pad and you still see this, the model is simply missing from the app\'s database. That one is fixable, and we would like to hear about it.\n\nHead cleaning and the nozzle check still work on this printer. They are on the Maintenance page.</string>

    <!-- Maintenance panel. -->
    <string name="maintenance_head_cleaning">Head Cleaning</string>
    <string name="maintenance_nozzle_check">Nozzle Check</string>
    <string name="maintenance_note">Head cleaning consumes ink and adds to the waste ink counters.</string>

    <!-- Dialog actions shared by more than one dialog. -->
    <string name="action_cancel">Cancel</string>
    <string name="action_ok">OK</string>
    <string name="action_close">Close</string>

    <!-- Reset waste counters dialog. -->
    <string name="dialog_reset_title">Reset waste counters</string>
    <string name="dialog_reset_warning">Resetting waste ink counters modifies internal printer firmware values. Use at your own risk.</string>
    <string name="field_target_percentage">Target percentage</string>
    <string name="action_reset_counters">Reset Counters</string>

    <!-- Head cleaning dialog, for models that accept service cleaning. -->
    <string name="dialog_cleaning_title">Head cleaning</string>
    <string name="dialog_cleaning_body">Head cleaning consumes ink. Choose the cleaning level supported by this printer.</string>
    <string name="action_start_cleaning">Start Cleaning</string>

    <!-- Generic ESC/P2 cleaning dialog, used when service cleaning is refused. -->
    <string name="dialog_generic_cleaning_body">This mode sends a generic Epson ESC/P2 maintenance job. Support may vary by model.</string>
    <string name="cleaning_all_nozzles">Clean all nozzles</string>
    <string name="cleaning_black_nozzle">Clean the black ink nozzle</string>
    <string name="cleaning_color_nozzles">Clean the color ink nozzles</string>
    <string name="cleaning_alternative_mode">Head cleaning (alternative mode)</string>
    <string name="cleaning_power_clean">Power Clean</string>

    <!-- Service cleaning modes, as the model database names them.
         The dialog is read, so it gets these labels. The protocol log keeps the
         database wording instead, because it is a diagnostic record and people
         search for the exact string. That wording also carries a leftover "%"
         where a placeholder was never substituted, which these drop.
         A name the table does not know falls back to the database wording. -->
    <string name="cleaning_mode_gentle">Gentle cleaning</string>
    <string name="cleaning_mode_normal">Normal cleaning</string>
    <string name="cleaning_mode_medium">Medium cleaning</string>
    <string name="cleaning_mode_strong">Strong cleaning</string>
    <string name="cleaning_mode_gentle_mode">Gentle cleaning (mode)</string>
    <string name="cleaning_mode_normal_mode">Normal cleaning (mode)</string>
    <string name="cleaning_mode_strong_mode">Strong cleaning (mode)</string>
    <string name="cleaning_mode_strong_a">Strong cleaning, mode A</string>
    <string name="cleaning_mode_strong_b">Strong cleaning, mode B</string>
    <string name="cleaning_all_gentle">Gentle, all nozzles</string>
    <string name="cleaning_all_normal">Normal, all nozzles</string>
    <string name="cleaning_all_medium">Medium, all nozzles</string>
    <string name="cleaning_all_strong">Strong, all nozzles</string>
    <string name="cleaning_black_gentle">Gentle, black nozzle</string>
    <string name="cleaning_black_normal">Normal, black nozzle</string>
    <string name="cleaning_black_medium">Medium, black nozzle</string>
    <string name="cleaning_black_strong">Strong, black nozzle</string>
    <string name="cleaning_color_gentle">Gentle, color nozzles</string>
    <string name="cleaning_color_normal">Normal, color nozzles</string>
    <string name="cleaning_color_medium">Medium, color nozzles</string>
    <string name="cleaning_color_strong">Strong, color nozzles</string>

    <!-- Nozzle check dialog. There is one check, not two: the sequence is what
         escputil sends and what yusnel-rojas proved on hardware. The pair of
         options that used to live here were the two halves of that sequence
         offered separately, which is why one of them did nothing. -->
    <string name="dialog_nozzle_check_title">Nozzle check</string>
    <string name="action_print_test">Print Test</string>
    <string name="dialog_nozzle_check_body">Prints a nozzle check page. It uses a sheet of paper and a little ink, and it is the only way to tell whether a head cleaning is worth doing.</string>

    <!-- About dialog. The repository label and the donation line still point at
         the upstream project and are pending the fork's own repository. -->
    <string name="dialog_about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_epson_only">Works with Epson inkjet printers only.</string>
    <!-- Shown only once the fork publishes releases of its own. The app holds no
         network permission, so this opens the page rather than checking. -->
    <string name="action_check_updates">Check for updates</string>
    <string name="about_updates_note">Opens the releases page in your browser. The app itself never goes online.</string>
    <string name="about_repo_label">GitHub: DSGM-GMSD/e-padreset</string>
    <string name="action_open_repo">Open Repo</string>
    <string name="about_donation">Donate now to support development of this and my other free apps, thank you!</string>
    <string name="action_open_github">Open GitHub Repo</string>

    <!-- Exit confirmation. -->
    <string name="dialog_exit_title">Exit app</string>
    <string name="dialog_exit_body">Do you want to exit and close %1$s?</string>
    <string name="action_exit">Exit</string>

    <!-- Titles for the dialog shown after an action succeeds. One per kind of
         outcome, because the app knows different amounts about each: a counter
         reset is read back and verified, a print job is only sent and has no
         acknowledgement to wait for. A single title said the same thing about
         both, which was true for one and a claim for the other. -->
    <string name="dialog_counters_updated_title">Counters updated</string>
    <string name="dialog_job_sent_title">Job sent</string>

    <!-- Error callout. The title is fixed; the body is either a localized
         message raised by the ViewModel, or this generic line when the failure
         was a technical one with no localized wording of its own. -->
    <string name="callout_operation_failed">Operation failed</string>

    <!-- Messages raised by the ViewModel. -->
    <string name="error_printer_not_connected">Printer is not connected</string>
    <!-- Shown in the red callout when a forced rescan comes up empty. The Wi-Fi
         clause lives here and not in the "No printer" hint on purpose: the hint
         is ambient, seen by everyone on every launch, and a reader who does not
         have the language should not meet a wall of text there. This one only
         appears after the user asked for a rescan, which is when the question
         "why can it not see mine?" is actually being asked.

         "Note:" is load-bearing, not decoration. Without it the two sentences
         sit side by side and read as a diagnosis — as if the app had worked out
         that the user was reaching for the printer over Wi-Fi, which may have
         nothing to do with why the scan came up empty. Marked as a note it is
         what it is: an aside about what this app does. -->
    <string name="error_no_printer_detected">No Epson printer detected over USB OTG. Note: this app does not work over Wi-Fi.</string>
    <!-- Raised when a USB printer is attached but its vendor is not Epson. The
         generic line above reads as a fault to someone holding a printer, so
         this one names the real reason: the app is Epson-only. -->
    <string name="error_non_epson_printer_detected">A printer is connected over USB, but it is not an Epson. This app works with Epson inkjet printers only.</string>
    <string name="error_connect_failed">Could not open a maintenance session with the printer</string>

    <!-- Shown when the printer is unplugged while the app is open. A statement
         rather than a failure: nothing the user did went wrong. -->
    <string name="notice_printer_disconnected">The printer was disconnected. Plug it back in and tap refresh to read it again.</string>

    <!-- Connection failures, resolved from PrinterService.ConnectFailure so the
         callout can name the actual cause instead of a generic failure. -->
    <string name="error_connect_permission_denied">USB access was denied. Reconnect the printer and accept the permission request.</string>
    <string name="error_connect_no_interfaces">This USB device has no interface the app can use. It may not be a supported Epson printer.</string>
    <string name="error_connect_unsupported_model">This Epson model is not in the app\'s database, so no maintenance session can be opened. Unlike a printer with a maintenance box, this is not permanent: the model can be supported once its data is added.</string>
    <string name="error_connect_unsupported_model_named">The Epson model \'%1$s\' is not in the app\'s database, so no maintenance session can be opened. Unlike a printer with a maintenance box, this is not permanent: the model can be supported once its data is added.</string>
    <!-- The mirror image of the two lines above. The model is missing from the
         database as well, but the community database classifies it as using a
         maintenance box, so adding it would never enable a reset. Kept apart so
         the app does not promise an outcome the hardware cannot deliver. -->
    <string name="error_connect_unsupported_model_box">This Epson model is not in the app\'s database, and the community database classifies it as using a maintenance box. Adding it would enable head cleaning and the nozzle check, but never a counter reset: the count lives on the box\'s own chip.</string>
    <string name="error_connect_unsupported_model_box_named">The Epson model \'%1$s\' is not in the app\'s database, and the community database classifies it as using a maintenance box. Adding it would enable head cleaning and the nozzle check, but never a counter reset: the count lives on the box\'s own chip.</string>
    <string name="error_connect_dot4_nak">The printer refused the maintenance session. Turn it off and on again, then retry.</string>

    <!-- Offered under the callout when the model is missing from the database
         and is not a maintenance-box model: the one case where a report from
         the user is what gets the model supported.
         The note is deliberately destination-agnostic: the issue button only
         appears once the fork has a repository of its own, and until then the
         clipboard is the whole feature. -->
    <string name="action_report_model">Report this model</string>
    <string name="action_copy_report">Copy report</string>
    <string name="report_model_note">The report carries the model, the printer\'s device ID without its serial number, and the last lines of the protocol log. Nothing leaves your device on its own.</string>
    <string name="report_copied">Report copied</string>
    <string name="msg_counters_updated">Waste ink counters have been updated. Restart the printer if required by the model.</string>
    <!-- Raised when the counters read back after a write do not match the value
         that was asked for, which means the printer did not apply it. -->
    <string name="error_counters_not_applied">The printer did not apply the new values: the counters still read %1$s. Nothing was changed. The write was most likely rejected.</string>
    <string name="msg_cleaning_sent_named">Head cleaning \'%1$s\' command has been sent. Wait for the printer to start the routine, then refresh status manually.</string>
    <string name="msg_cleaning_sent">Head cleaning job has been sent. Wait for the printer to start the routine, then refresh status manually.</string>
    <string name="msg_nozzle_check_sent">Nozzle check print job has been sent. Wait for the page to print.</string>

    <!-- Readouts. The em dash stands for "no reading yet". -->
    <string name="percent_value">%1$d%%</string>
    <string name="waste_counter_default_name">Waste ink counter %1$d</string>

    <!-- Printer state, resolved from the code the printer reports. EpsonProtocol
         still produces English text for the diagnostic log; the UI maps the code
         to these labels, so the status line is translatable. -->
    <string name="printer_state_self_printing">Self printing</string>
    <string name="printer_state_busy">Busy</string>
    <string name="printer_state_waiting">Waiting</string>
    <string name="printer_state_idle">Idle</string>
    <string name="printer_state_pause">Paused</string>
    <string name="printer_state_cleaning">Cleaning</string>
    <string name="printer_state_error">Error</string>

    <!-- Printer error, resolved from the code the printer reports. -->
    <string name="printer_error_interface">Interface error</string>
    <string name="printer_error_paper_jam">Paper jam</string>
    <string name="printer_error_ink_out">Ink out</string>
    <string name="printer_error_service_required">Service required</string>
    <string name="printer_error_cover_open">Cover open</string>

    <!--
      Still not translatable, and deliberately left in the protocol layer:

        Ink colour names (InkLevel.color), e.g. "Black", "Light Cyan".

      They are never shown to the user. The gauges display short labels derived
      from them, and the same strings double as matching keys for the sort order
      and for the gauge colour, so translating them would change behaviour
      rather than just wording.
    -->
</resources>
