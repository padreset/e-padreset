    <!-- Titles for the dialog shown after an action succeeds. One per kind of
         outcome, because the app knows different amounts about each: a counter
         reset is read back and verified, a print job is only sent and has no
         acknowledgement to wait for. A single title said the same thing about
         both, which was true for one and a claim for the other. -->
    <string name="dialog_counters_updated_title">计数器已更新</string>
